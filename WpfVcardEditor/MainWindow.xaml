<Window x:Class="WpfVcardEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfVcardEditor"
        mc:Ignorable="d"
        Title="VCARD EDITOR"
        Height="600"
        Width="900"
        MinWidth="500">

    <DockPanel>

        <Menu DockPanel.Dock="Top">
            <MenuItem Header="vCard">
                <MenuItem Header="New..." Name="mnuNew" Click="mnuNew_Click"/>
                <MenuItem Header="Open..." Name="mnuOpen" Click="mnuOpen_Click"/>
                <MenuItem Header="Save" Name="mnuSave" Click="mnuSave_Click" IsEnabled="False"/>
                <MenuItem Header="Save As..." Name="mnuSaveAs" Click="mnuSaveAs_Click"/>
                <MenuItem Header="Exit" Name="mnuExit" Click="mnuExit_Click"/>
            </MenuItem>

            <MenuItem Header="Help">
                <MenuItem Header="About" Name="mnuAbout" Click="mnuAbout_Click"/>
            </MenuItem>
        </Menu>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Name="txtCurrentCardStatus" Text="huidige kaart: (geen geopend)"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock Name="txtPercentageStatus" Text="percentage ingevuld: n.a."/>
            </StatusBarItem>
        </StatusBar>

        <TabControl Name="tabMain" Margin="10">

            <TabItem Header="Persoonlijk">
                <Border BorderBrush="LightGray" BorderThickness="1" Padding="15">
                    <Grid HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="Auto" MaxWidth="600"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Voornaam" Margin="10" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Name="txtFirstname" Width="260" Margin="10" TextChanged="Card_Changed"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Achternaam" Margin="10" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Name="txtLastname" Width="260" Margin="10" TextChanged="Card_Changed"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Geboortedatum" Margin="10" VerticalAlignment="Center"/>
                        <DatePicker Grid.Row="2" Grid.Column="1" Name="datBirthday" Width="140" Margin="10" SelectedDateChanged="Card_Changed"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Geslacht" Margin="10" VerticalAlignment="Center"/>
                        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="10">
                            <RadioButton Name="radFemale" Content="vrouw" Margin="0,0,10,0" Checked="Card_Changed"/>
                            <RadioButton Name="radMale" Content="man" Margin="0,0,10,0" Checked="Card_Changed"/>
                            <RadioButton Name="radUnknown" Content="onbekend" Checked="Card_Changed"/>
                        </StackPanel>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Privé email" Margin="10" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="4" Grid.Column="1" Name="txtPrivateEmail" Width="260" Margin="10" TextChanged="Card_Changed"/>

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Privé telefoon" Margin="10" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="5" Grid.Column="1" Name="txtPrivatePhone" Width="260" Margin="10" TextChanged="Card_Changed"/>

                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Foto" Margin="10" VerticalAlignment="Center"/>
                        <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" Margin="10">
                            <Button Name="btnSelectPhoto" Content="SELECTEER..." Width="110" Click="btnSelectPhoto_Click"/>
                            <TextBlock Name="txtPhotoFileName" Text="(geen geselecteerd)" Margin="10,5,0,0"/>
                        </StackPanel>

                        <Border Grid.Row="7" Grid.Column="1"
                                Width="120"
                                Height="150"
                                Margin="10"
                                HorizontalAlignment="Left"
                                BorderBrush="LightGray"
                                BorderThickness="1">
                            <Image Name="imgPhoto" Stretch="Uniform"/>
                        </Border>
                    </Grid>
                </Border>
            </TabItem>

            <TabItem Header="Werk">
                <Border BorderBrush="LightGray" BorderThickness="1" Padding="15">
                    <Grid HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="Auto" MaxWidth="600"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Bedrijf" Margin="10" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Name="txtCompany" Width="260" Margin="10" TextChanged="Card_Changed"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Jobtitel" Margin="10" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Name="txtJobTitle" Width="260" Margin="10" TextChanged="Card_Changed"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Werk email" Margin="10" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Name="txtWorkEmail" Width="260" Margin="10" TextChanged="Card_Changed"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Werk telefoon" Margin="10" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="3" Grid.Column="1" Name="txtWorkPhone" Width="260" Margin="10" TextChanged="Card_Changed"/>
                    </Grid>
                </Border>
            </TabItem>

            <TabItem Header="Sociaal">
                <Border BorderBrush="LightGray" BorderThickness="1" Padding="15">
                    <Grid HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="Auto" MaxWidth="600"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="LinkedIn" Margin="10" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Name="txtLinkedIn" Width="260" Margin="10" TextChanged="Card_Changed"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Facebook" Margin="10" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Name="txtFacebook" Width="260" Margin="10" TextChanged="Card_Changed"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Instagram" Margin="10" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Name="txtInstagram" Width="260" Margin="10" TextChanged="Card_Changed"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Youtube" Margin="10" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="3" Grid.Column="1" Name="txtYoutube" Width="260" Margin="10" TextChanged="Card_Changed"/>
                    </Grid>
                </Border>
            </TabItem>

        </TabControl>
    </DockPanel>
</Window>