<Page x:Class="WPFDokter.Pages.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Login" Background="White">
    <Grid Margin="40">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="400">
            <TextBlock Text="Login" FontSize="28" FontWeight="Bold" 
                       Foreground="#1F1F1F" TextAlignment="Center" Margin="0,0,0,30"/>

            <TextBlock Text="Email" FontSize="14" Margin="0,5"/>
            <TextBox x:Name="txtEmail" FontSize="14" Padding="8" 
                     Text="alexandre@dokterspraktijk.be"/>

            <TextBlock Text="Wachtwoord" FontSize="14" Margin="0,15,0,5"/>
            <PasswordBox x:Name="txtPaswoord" FontSize="14" Padding="8" 
                         Password="t9ZmRrAbSfCv"/>

            <Button x:Name="btnLogin" Content="Inloggen" Click="btnLogin_Click"
                    Background="#1F1F1F" Foreground="White" FontSize="16" 
                    Padding="10" Margin="0,25,0,0" BorderThickness="0"/>

            <!-- TextBlock voor foutmeldingen (geen MessageBox volgens opgave) -->
            <TextBlock x:Name="txtFoutmelding" Foreground="Red" FontSize="13"
                       TextWrapping="Wrap" Margin="0,15,0,0" TextAlignment="Center"/>
        </StackPanel>
    </Grid>
</Page>
