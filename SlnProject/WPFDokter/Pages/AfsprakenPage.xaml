<Page x:Class="WPFDokter.Pages.AfsprakenPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Afspraken" Background="White">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Mijn Afspraken" 
                   FontSize="24" FontWeight="Bold" Foreground="#1F1F1F" Margin="0,0,0,20"/>

        <!-- Linker kolom: kalender om datum te kiezen -->
        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,20,0">
            <TextBlock Text="Selecteer een datum:" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>
            <Calendar x:Name="kalender" SelectedDatesChanged="kalender_SelectedDatesChanged"/>
        </StackPanel>

        <!-- Rechter kolom: lijst van afspraken + details + annuleren knop -->
        <Grid Grid.Row="1" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" x:Name="txtGekozenDatum" Text="Geen datum geselecteerd" 
                       FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>

            <!-- ListBox toont de afspraken (ListBox mag wel, geen ListView/DataGrid) -->
            <ListBox Grid.Row="1" x:Name="lstAfspraken" FontSize="13"
                     SelectionChanged="lstAfspraken_SelectionChanged"/>

            <TextBlock Grid.Row="2" Text="Reden voor consultatie:" FontWeight="Bold" Margin="0,15,0,5"/>
            <TextBlock Grid.Row="3" x:Name="txtReden" TextWrapping="Wrap" 
                       Background="#F0F0F0" Padding="10" MinHeight="50"/>

            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                <TextBlock x:Name="txtFoutmelding" Foreground="Red" VerticalAlignment="Center" Margin="0,0,15,0"/>
                <Button x:Name="btnAnnuleren" Content="Annuleren" Click="btnAnnuleren_Click"
                        Background="#B91C1C" Foreground="White" Padding="15,8" 
                        BorderThickness="0" IsEnabled="False"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
