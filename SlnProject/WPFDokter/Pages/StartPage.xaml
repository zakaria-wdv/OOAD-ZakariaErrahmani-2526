<Page x:Class="WPFDokter.Pages.StartPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Start" Background="White">
    <Grid Margin="40">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="700">
            <TextBlock Text="Welkom in de Dokter Portaal" FontSize="32" FontWeight="Bold" 
                       Foreground="#1F1F1F" TextAlignment="Center" Margin="0,0,0,20"/>
            <TextBlock TextWrapping="Wrap" FontSize="16" TextAlignment="Center" Margin="0,0,0,15"
                       Text="Deze applicatie is ontworpen voor dokters van onze dokterspraktijk."/>
            <TextBlock TextWrapping="Wrap" FontSize="14" TextAlignment="Center" Margin="0,0,0,10"
                       Text="Met deze app kan u:"/>
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="• Uw afspraken raadplegen per dag" FontSize="14" Margin="0,4"/>
                <TextBlock Text="• Afspraken annuleren wanneer nodig" FontSize="14" Margin="0,4"/>
                <TextBlock Text="• Een overzicht van uw patiënten bekijken" FontSize="14" Margin="0,4"/>
                <TextBlock Text="• Patiëntinformatie toevoegen, bewerken of verwijderen" FontSize="14" Margin="0,4"/>
            </StackPanel>
            <TextBlock TextWrapping="Wrap" FontSize="14" TextAlignment="Center" Margin="0,20,0,0"
                       Text="Klik op 'Login' in het linker menu om aan te melden."/>
        </StackPanel>
    </Grid>
</Page>
