<Page x:Class="WPFPatient.Pages.ProfielPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Mijn Profiel" Background="White">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Mijn Profiel" 
                   FontSize="24" FontWeight="Bold" Foreground="#1F1F1F" Margin="0,0,0,20"/>

        <Grid Grid.Row="1" MaxWidth="600" HorizontalAlignment="Left">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Foto in cirkel -->
            <Border Grid.Column="0" Width="150" Height="150" 
                    CornerRadius="75" Background="#E2E8F0" ClipToBounds="True"
                    VerticalAlignment="Top">
                <Image x:Name="imgFoto" Stretch="UniformToFill"/>
            </Border>

            <!-- Info kolom -->
            <StackPanel Grid.Column="1">
                <TextBlock x:Name="txtNaam" FontSize="22" FontWeight="Bold" Margin="0,0,0,15"/>

                <TextBlock Text="Email:" FontWeight="Bold" FontSize="13" Margin="0,5,0,0"/>
                <TextBlock x:Name="txtEmail" FontSize="14" Margin="0,0,0,5"/>

                <TextBlock Text="GSM:" FontWeight="Bold" FontSize="13" Margin="0,5,0,0"/>
                <TextBlock x:Name="txtGsm" FontSize="14" Margin="0,0,0,5"/>

                <TextBlock Text="Geslacht:" FontWeight="Bold" FontSize="13" Margin="0,5,0,0"/>
                <TextBlock x:Name="txtGeslacht" FontSize="14" Margin="0,0,0,5"/>

                <TextBlock Text="Geboortedatum:" FontWeight="Bold" FontSize="13" Margin="0,5,0,0"/>
                <TextBlock x:Name="txtGeboortedatum" FontSize="14" Margin="0,0,0,5"/>

                <TextBlock Text="Notificaties:" FontWeight="Bold" FontSize="13" Margin="0,5,0,0"/>
                <TextBlock x:Name="txtNotificaties" FontSize="14" Margin="0,0,0,5"/>
            </StackPanel>
        </Grid>

        <Button Grid.Row="2" Content="Bewerken" Click="btnBewerken_Click"
                Background="#1F1F1F" Foreground="White" Padding="20,10" 
                BorderThickness="0" HorizontalAlignment="Left" Margin="0,20,0,0"/>
    </Grid>
</Page>
