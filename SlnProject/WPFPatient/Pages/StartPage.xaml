<Page x:Class="WPFPatient.Pages.StartPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Start" Background="White">
    <Grid Margin="40">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="700">
            <TextBlock Text="Welkom bij uw Patiënt Portaal" FontSize="32" FontWeight="Bold" 
                       Foreground="#1F1F1F" TextAlignment="Center" Margin="0,0,0,20"/>
            <TextBlock TextWrapping="Wrap" FontSize="16" TextAlignment="Center" Margin="0,0,0,15"
                       Text="Welkom bij de online portaal van onze dokterspraktijk."/>
            <TextBlock TextWrapping="Wrap" FontSize="14" TextAlignment="Center" Margin="0,0,0,10"
                       Text="Hier kan u:"/>
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="• Uw geplande afspraken bekijken" FontSize="14" Margin="0,4"/>
                <TextBlock Text="• Nieuwe afspraken inplannen bij de dokter van uw keuze" FontSize="14" Margin="0,4"/>
                <TextBlock Text="• Toekomstige afspraken annuleren" FontSize="14" Margin="0,4"/>
                <TextBlock Text="• Uw profielgegevens raadplegen en bewerken" FontSize="14" Margin="0,4"/>
            </StackPanel>
            <TextBlock TextWrapping="Wrap" FontSize="14" TextAlignment="Center" Margin="0,20,0,0"
                       Text="Klik op 'Login' in het linker menu om aan te melden met uw account."/>
        </StackPanel>
    </Grid>
</Page>
