<Window x:Class="WPFPatient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dokterspraktijk - Patiënt App" Height="700" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#F7F7F7">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>



        <!-- Header bovenaan met titel en (na inloggen) naam + foto van patiënt -->
        <Border Grid.Row="0" Grid.ColumnSpan="2" Background="#1F1F1F" Padding="20,10">
            <Grid>
                <TextBlock Text="Dokterspraktijk - Patiënt Portaal" 
                   Foreground="White" FontSize="22" FontWeight="Bold"
                   VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="txtIngelogdeNaam" Text="" Foreground="White"
                       FontSize="16" VerticalAlignment="Center" Margin="0,0,15,0"/>
                    <Border Width="50" Height="50" CornerRadius="25" 
                    Background="White" ClipToBounds="True">
                        <Image x:Name="imgIngelogdeFoto" Stretch="UniformToFill"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
        <!-- Linker navigatie balk met knoppen -->
        <Border Grid.Row="1" Grid.Column="0" Background="#2D2D2D">
            <StackPanel Margin="10">
                <Button x:Name="btnStart" Content="Start" Click="btnStart_Click"
                        Height="50" Margin="0,5" FontSize="14" Background="#1F1F1F"
                        Foreground="White" BorderThickness="0"/>
                <Button x:Name="btnLogin" Content="Login" Click="btnLogin_Click"
                        Height="50" Margin="0,5" FontSize="14" Background="#1F1F1F"
                        Foreground="White" BorderThickness="0"/>
                <Button x:Name="btnAfspraken" Content="Afspraken" Click="btnAfspraken_Click"
                        Height="50" Margin="0,5" FontSize="14" Background="#1F1F1F"
                        Foreground="White" BorderThickness="0" IsEnabled="False"/>
                <Button x:Name="btnProfiel" Content="Profiel" Click="btnProfiel_Click"
                        Height="50" Margin="0,5" FontSize="14" Background="#1F1F1F"
                        Foreground="White" BorderThickness="0" IsEnabled="False"/>
                <Button x:Name="btnUitloggen" Content="Uitloggen" Click="btnUitloggen_Click"
                        Height="50" Margin="0,20,0,5" FontSize="14" Background="#B91C1C"
                        Foreground="White" BorderThickness="0" IsEnabled="False"/>
            </StackPanel>
        </Border>

        <!-- Hoofd frame waarin we de verschillende pagina's laden -->
        <Frame x:Name="mainFrame" Grid.Row="1" Grid.Column="1"
               NavigationUIVisibility="Hidden" Background="White"/>
    </Grid>
</Window>
